# ============================================
# MARTIN-CODER CONFIGURATION
# ============================================

# --------------------------------------------
# AI PROVIDERS
# --------------------------------------------

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# LM Studio (local)
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_ENABLED=true

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_ENABLED=true

# Default AI Provider (claude, openai, lmstudio, ollama)
DEFAULT_AI_PROVIDER=claude
DEFAULT_AI_MODEL=claude-sonnet-4-5-20250929

# --------------------------------------------
# DATABASE
# --------------------------------------------

# PostgreSQL (production)
DATABASE_URL=postgresql://martin:martin_password@localhost:5432/martin_coder

# SQLite (development/simple setup)
# DATABASE_URL=sqlite:///./data/martin_coder.db

# --------------------------------------------
# REDIS
# --------------------------------------------

REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# AUTHENTICATION
# --------------------------------------------

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First admin user (created on first startup)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme123

# --------------------------------------------
# SANDBOX EXECUTION
# --------------------------------------------

SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1

# --------------------------------------------
# RAG SYSTEM
# --------------------------------------------

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Embeddings (local or openai)
EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=text-embedding-3-small  # For OpenAI

# --------------------------------------------
# GIT INTEGRATION
# --------------------------------------------

# GitHub OAuth (optional, for GitHub integration)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitLab OAuth (optional)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# --------------------------------------------
# SERVER
# --------------------------------------------

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Frontend
FRONTEND_URL=http://localhost:3000

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --------------------------------------------
# LOGGING
# --------------------------------------------

LOG_LEVEL=INFO
LOG_FORMAT=json

# --------------------------------------------
# DEVELOPMENT
# --------------------------------------------

DEBUG=false
ENVIRONMENT=production
