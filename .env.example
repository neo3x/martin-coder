# ============================================================
# MARTIN-CODER v2.0 - TypeScript/Bun Configuration
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database (SQLite - no server required!) ──────────────────
DATABASE_PATH=./data/martin-coder.db

# ── Security ──────────────────────────────────────────────────
# REQUIRED: Must be at least 32 characters - keep it secret!
# Generate: openssl rand -base64 64
SECRET_KEY=change-me-to-a-strong-random-secret-key-min-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── AI Providers ─────────────────────────────────────────────
# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=sk-...

# Google Gemini (https://aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# Ollama (local, no key required)
OLLAMA_BASE_URL=http://localhost:11434

# LM Studio (local OpenAI-compatible)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Default provider and model
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_AI_MODEL=claude-sonnet-4-5-20250929

# ── OAuth ─────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LSP Settings ─────────────────────────────────────────────
LSP_ENABLED=true
LSP_TIMEOUT_MS=5000

# ── MCP Settings ─────────────────────────────────────────────
MCP_ENABLED=true

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_AUTH=10

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── First Admin User ──────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-strong-password
