# ── Stage 1: Build ──────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy workspace manifests
COPY package.json ./
COPY packages/web/package.json ./packages/web/
COPY packages/shared/package.json ./packages/shared/

# Install dependencies (npm for Next.js workspace compatibility)
RUN npm install --workspace=packages/web --workspace=packages/shared

# Copy source
COPY packages/web ./packages/web
COPY packages/shared ./packages/shared
COPY tsconfig.json ./

# Build Next.js
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run --workspace=packages/web build

# ── Stage 2: Runtime ─────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0

RUN addgroup -S martin && adduser -S martin -G martin

# Copy standalone Next.js output
COPY --from=builder --chown=martin:martin /app/packages/web/.next/standalone ./
COPY --from=builder --chown=martin:martin /app/packages/web/.next/static ./.next/static
COPY --from=builder --chown=martin:martin /app/packages/web/public ./public

USER martin

EXPOSE 3000

CMD ["node", "server.js"]
