# ============================================
# Docker Ignore File — Martin-Coder v2.0
# TypeScript/Bun Stack
# ============================================

# Git
.git
.gitignore
.gitattributes

# Node.js / Bun
**/node_modules
**/.npm
**/.pnpm-store

# Next.js build output (rebuilt inside container)
**/.next
**/out

# IDEs and editors
**/.idea
**/.vscode
**/*.swp
**/*.swo

# OS files
**/.DS_Store
**/Thumbs.db

# Docker files (not needed in build context)
**/Dockerfile*
**/docker-compose*.yml
**/.docker

# Documentation (not needed in containers)
**/*.md

# Data and logs (mounted as volumes)
**/data
**/logs
**/*.log

# Environment files (passed via env_file in compose)
**/.env
**/.env.*
!**/.env.example

# Build artifacts (rebuilt inside container)
**/dist

# Python backup (not needed in containers)
_python_backup

# Temporary files
**/tmp
**/temp
**/*.tmp

# CI/CD
**/.github
**/.gitlab-ci.yml

# Misc
**/LICENSE
**/.editorconfig
**/.prettierrc*
