# ============================================
# Docker Ignore File
# Excludes files from Docker build context
# ============================================

# Git
.git
.gitignore
.gitattributes

# Node.js
**/node_modules
**/.npm
**/.pnpm-store

# Next.js
**/.next
**/out

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/pip-log.txt
**/.venv
**/venv
**/.env
**/env
**/*.egg-info
**/.eggs
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
**/.coverage
**/htmlcov
**/.tox

# IDEs and editors
**/.idea
**/.vscode
**/*.swp
**/*.swo
**/.*~

# OS files
**/.DS_Store
**/Thumbs.db

# Docker
**/Dockerfile*
**/docker-compose*.yml
**/.docker

# Documentation (not needed in containers)
**/docs
**/*.md
!apps/*/README.md

# Tests (optional - comment out if you need tests in container)
# **/tests
# **/test
# **/*_test.py
# **/test_*.py

# Data and logs
**/data
**/logs
**/*.log

# Local configuration
**/.env
**/.env.*
!**/.env.example

# Build artifacts
**/dist
**/build
**/*.egg
**/.eggs

# Temporary files
**/tmp
**/temp
**/*.tmp

# Sandbox data (will be mounted as volume)
**/sandboxes

# CI/CD
**/.github
**/.gitlab-ci.yml
**/.travis.yml

# Misc
**/LICENSE
**/CHANGELOG.md
**/CONTRIBUTING.md
**/.editorconfig
**/.prettierrc*
# **/.eslintrc*  # Commented out - Next.js may need eslint config
# **/tsconfig*.json  # Commented out - Next.js needs tsconfig.json for build
**/jest.config.*
**/pytest.ini
# **/setup.py  # Commented out - Python projects may need this
# **/setup.cfg  # Commented out - Python projects may need this
# **/pyproject.toml  # Commented out - Python projects may need this
